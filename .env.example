# Environment variable reference; blank entries are intentional.
# Spring Boot does not load this file automatically. Export the required values before starting an app.
# Tests generate their own credentials. See docs/running.md for local execution.
# Required credentials have no defaults; missing or empty values prevent startup.

# ── app-waiting ───────────────────────────────────────────
# Required by the api profile. Waiting cookie HS256 signing key (at least 32 bytes), admin API key (at least 16 bytes)
WAIT_SECRET=
QUEUE_ADMIN_KEY=
# Shared by api and worker. Queue Redis (default localhost:6379)
QUEUE_REDIS_HOST=
QUEUE_REDIS_PORT=

# ── app-booking ───────────────────────────────────────────
# MySQL. URL defaults to jdbc:mysql://localhost:3306/ticketing; the root account is not allowed
BOOKING_DB_URL=
BOOKING_DB_USERNAME=
BOOKING_DB_PASSWORD=
# Booking Redis (app-worker uses the same Redis; default localhost:6379)
BOOKING_REDIS_HOST=
BOOKING_REDIS_PORT=

# ── app-worker ────────────────────────────────────────────
# MySQL. Same database as booking, but separate keys so the worker can use its own account
WORKER_DB_URL=
WORKER_DB_USERNAME=
WORKER_DB_PASSWORD=
