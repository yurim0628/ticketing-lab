# ── Secrets: never commit ─────────────────────────────────
# Keep local credentials outside version control.
.env
.env.*
!.env.example
.secrets/
*.pem
*.key
*.p12
*.jks
*.jwt
**/dev-keys/
# Optional, private input for the local name-scan command and pre-commit hook.
.forbidden-words
.lab/
__pycache__/

# ── Build and tooling ─────────────────────────────────────
.gradle/
**/build/
out/
.idea/
*.iml
*.log
.DS_Store

# ── Load test output ──────────────────────────────────────
k6/out/
k6/tokens*.json
